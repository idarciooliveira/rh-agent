# LinkedIn profile database (SQLite)
DATABASE_URL=./data/app.db

# AI model access (required for live profile parsing and Phase 2+ analysis)
AI_GATEWAY_API_KEY=your-ai-gateway-key

# Apify token for fetching LinkedIn profiles by username (live mode)
# console.apify.com > Settings > API & Integrations
APIFY_TOKEN=your-apify-token

# Apify actor that scrapes public LinkedIn profiles
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-profile-scraper

# Spend cap in USD for a single profile fetch (actual cost is about 0.004)
APIFY_MAX_COST_USD=0.05

# Mock AI mode — simulate parse responses without calling the gateway (dev/test only)
AI_MOCK_MODE=false

# Artificial delay in milliseconds when AI_MOCK_MODE=true (exercises parsing UI)
AI_MOCK_DELAY_MS=1500

# Max PDF upload size in megabytes (Phase 1)
MAX_PDF_SIZE_MB=5

# Anonymous session cookie name
SESSION_COOKIE_NAME=linkedin_coach_session

# Optional app title for client
VITE_APP_TITLE=LinkedIn Coach Agent
